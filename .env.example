APP_NAME=分布式光伏财产险 OCR 与信息提取模块
DEBUG=false
OUTPUT_DIR=output
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=40000000
MAX_PDF_TOTAL_PIXELS=200000000
MAX_PACKAGE_FILES=20
MAX_PACKAGE_SIZE_MB=100
MAX_JSON_BODY_MB=25
MAX_CONCURRENT_OCR=1
PDF_DPI=200
OCR_LANGUAGE=ch
OCR_DEVICE=cpu
OCR_ENABLE_MKLDNN=false
# 使用纯英文缓存路径，规避 PaddlePaddle 在部分中文 Windows 路径下的模型加载问题。
OCR_MODEL_CACHE_DIR=C:/Users/Public/paddlex-cache
SAVE_RESULTS=false
CLASSIFICATION_REVIEW_THRESHOLD=0.55
FIELD_CONFIDENCE_REVIEW_THRESHOLD=0.70
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.75
